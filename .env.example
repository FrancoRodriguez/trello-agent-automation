# Trello API Credentials (Get from https://trello.com/app-key)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here
TRELLO_BOARD_ID=your_trello_board_id_here

# Column Names
TRELLO_SOURCE_LIST=Progress
TRELLO_WORKING_LIST=AI in progress
TRELLO_QUESTIONS_LIST=AI open questions
TRELLO_TARGET_LIST=Testing

# Mobile Push Notifications via ntfy.sh (Optional)
# Subscribe to your topic on the free ntfy mobile app (iOS/Android)
NTFY_TOPIC=your_ntfy_topic_here
